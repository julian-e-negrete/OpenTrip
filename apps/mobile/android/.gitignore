gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Exception: app/debug.keystore is intentionally tracked. It's a debug
# key with Android's standard hardcoded alias/password ("androiddebugkey"
# / "android") — it protects nothing by design. It's pinned here (and
# referenced explicitly in app/build.gradle.kts) so every build, local or
# CI, produces the same signing certificate/SHA-1, which Google Sign-In
# validates against. See /docs/AUTH_SETUP.md.
!app/debug.keystore
